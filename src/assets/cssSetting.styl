// 農民曆：曆紙黃、墨黑、單一朱紅
paper = #efe3b4
paper_deep = #e4d49c
ink = #1b1b1b
ink_soft = #5b4f3a
red = #b01e23
red_deep = #8c1519

font_serif = 'Noto Serif TC', 'Noto Serif CJK TC', 'PMingLiU', serif

// 凶欄的細斜線網底
hatch()
  background-image repeating-linear-gradient(135deg, transparent 0 6px, rgba(27,27,27,0.08) 6px 7px)

// 圈註：吉凶、選取的流派
ring(c = red)
  display inline-flex
  align-items center
  justify-content center
  border 2px solid c
  border-radius 50%
  color c
